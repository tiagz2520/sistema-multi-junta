# Entorno EXCLUSIVAMENTE local y desechable para la presentación del grupo.
# NO utilizar estos valores en servidores, en internet o con datos personales reales.
# Usa otro nombre de proyecto Docker Compose y otros puertos si ya tienes servicios activos.
POSTGRES_DB=multi_junta_demo_tungurahua
POSTGRES_USER=multi_junta
POSTGRES_PASSWORD=solo_desarrollo
POSTGRES_PORT=5433

# Dos roles de base de datos con permisos diferenciados.
POSTGRES_APP_PASSWORD=app_solo_desarrollo
POSTGRES_MIGRATION_PASSWORD=migracion_solo_desarrollo

# Estas tres URL deben usar la MISMA base y el MISMO puerto local.
APP_DATABASE_URL=postgresql://multi_junta_app:app_solo_desarrollo@127.0.0.1:5433/multi_junta_demo_tungurahua?schema=multi_junta
MIGRATION_DATABASE_URL=postgresql://multi_junta_migrator:migracion_solo_desarrollo@127.0.0.1:5433/multi_junta_demo_tungurahua?schema=multi_junta
DEMO_ADMIN_DATABASE_URL=postgresql://multi_junta:solo_desarrollo@127.0.0.1:5433/multi_junta_demo_tungurahua?schema=multi_junta

# Credencial DESECHABLE compartida por las cuentas sintéticas de la demo.
# Las comillas son obligatorias: el símbolo # no debe interpretarse como comentario.
DEMO_PASSWORD="JuntaDemo#2026-Manual!"

HOST=127.0.0.1
PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:3000

# Debe coincidir EXACTAMENTE con el origen escrito en la barra del navegador.
AUTH_ORIGIN=http://127.0.0.1:5173
AUTH_IDLE_SECONDS=1800
AUTH_ABSOLUTE_SECONDS=43200
