# Valores desechables para desarrollo local.
POSTGRES_DB=multi_junta
POSTGRES_USER=multi_junta
POSTGRES_PASSWORD=solo_desarrollo
POSTGRES_PORT=5433

# El servicio de inicialización usa estos valores para los dos roles.
POSTGRES_APP_PASSWORD=app_solo_desarrollo
POSTGRES_MIGRATION_PASSWORD=migracion_solo_desarrollo

# URLs para ejecutar NestJS y Prisma CLI desde el equipo anfitrión.
APP_DATABASE_URL=postgresql://multi_junta_app:app_solo_desarrollo@127.0.0.1:5433/multi_junta?schema=multi_junta
MIGRATION_DATABASE_URL=postgresql://multi_junta_migrator:migracion_solo_desarrollo@127.0.0.1:5433/multi_junta?schema=multi_junta

HOST=127.0.0.1
PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:3000
