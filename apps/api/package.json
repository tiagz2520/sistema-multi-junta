{
  "name": "@multi-junta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && nest start --watch",
    "build": "npm run db:generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma.config.ts",
    "test": "npm run build && node --test test/health.e2e.test.mjs",
    "test:db": "node --env-file-if-exists=../../.env --test test/postgres.integration.mjs",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "prisma": "7.10.1"
  }
}
